# ShieldMe API - environment variables
# Copy to .env (dev) or .env.deploy (prod) and fill all CHANGE_ME values.
# NEVER commit .env or .env.deploy.

NODE_ENV=production
PORT=4005

# Public URL of the API (no trailing slash)
APP_URL=https://api.shieldme.example.com

# Database
# In compose.deploy.yml this is injected via POSTGRES_PASSWORD substitution.
DATABASE_URL=postgres://shieldme:CHANGE_ME@postgres:5432/alias_forwarder
POSTGRES_PASSWORD=CHANGE_ME

# Redis
REDIS_URL=redis://:CHANGE_ME@redis:6379
REDIS_PASSWORD=CHANGE_ME

# JWT - generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_32_CHARS_MIN
JWT_REFRESH_SECRET=CHANGE_ME_32_CHARS_MIN
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_SALT_ROUNDS=12

# Admin API bearer token - generate with: openssl rand -hex 32
# ADMIN_SECRET=CHANGE_ME

# Outbound mail provider: mailbaby (default) or resend. SES removed from active paths.
OUTBOUND_PROVIDER=mailbaby

# MailBaby SMTP credentials (required when OUTBOUND_PROVIDER=mailbaby)
# Never commit real values — inject from vault/secrets manager at runtime.
# MAILBABY_SMTP_USERNAME=CHANGE_ME
# MAILBABY_SMTP_PASSWORD=CHANGE_ME
# MAILBABY_DKIM_DOMAIN=shieldme.example.com
# MAILBABY_DKIM_SELECTOR=mail
# MAILBABY_DKIM_PRIVATE_KEY=CHANGE_ME
# Outbound-delivery hold. This does not enable automatic MailBaby DSN suppression.
MAILBABY_DSN_VERIFIED=false

# Trusted source IPs for structurally validated SMTP-relay DSNs only. Do not set for MailBaby.
SMTP_DSN_TRUSTED_SOURCE_IPS=

# Resend (required when OUTBOUND_PROVIDER=resend)
# RESEND_API_KEY=re_xxx

# Resend webhook signature verification (recommended in production)
# RESEND_WEBHOOK_SECRET=CHANGE_ME

# Platform domain - configure later via admin panel or pre-seed here
# PLATFORM_DOMAIN=mail.shieldme.example.com

# Queue payload encryption (recommended in production)
# Generate with: openssl rand -hex 32
# QUEUE_ENCRYPTION_SECRET=CHANGE_ME

# Spam scanner
SPAM_SCANNER_ENABLED=true
SPAM_SCANNER_THRESHOLD=0.9
SPAM_SCANNER_ACTION=tag

# Tracking protection
TRACKING_PROTECTION_ENABLED=true
TRACKING_PROTECTION_MODE=conservative

# SMTP ingress port (internal only in production)
SMTP_PORT=2525

BYO_SMTP_ENABLED=false
BYO_SMTP_PILOT_OWNER_IDS=
BYO_SMTP_APPROVED_HOSTS=
BYO_SMTP_PILOT_MAX_MONTHLY_FORWARDS=25
BYO_SMTP_PILOT_CONCURRENCY=1
RELAY_KMS_SOCKET_PATH=/run/shieldme-relay-kms/kms.sock
RELAY_METRICS_PORT=9405

# Frontend build arg (used by compose.deploy.yml build ARG)
VITE_API_BASE_URL=https://api.shieldme.example.com
