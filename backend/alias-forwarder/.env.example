NODE_ENV=development
PORT=4001
APP_URL=http://localhost:3000

# Optional — configure later via admin settings (POST /api/admin/config)
# PLATFORM_DOMAIN=mail.example.com
# RESEND_API_KEY=re_xxxxxxxxxxxxx

DATABASE_URL=postgres://postgres:password@localhost:5432/alias_forwarder
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-32-char-random-secret
JWT_REFRESH_SECRET=replace-with-another-32-char-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_SALT_ROUNDS=12

# Optional — webhook signature verification (recommended in production)
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxx

# Admin API bearer token (change in production)
# ADMIN_SECRET=change-me-in-production-32chars!!
