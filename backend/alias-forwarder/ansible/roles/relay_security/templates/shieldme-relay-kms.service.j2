[Unit]
Description=ShieldMe relay KEK service
After=network.target

[Service]
Type=simple
User=root
Group=shieldme
UMask=0007
RuntimeDirectory=shieldme-relay-kms
RuntimeDirectoryMode=0750
Environment=RELAY_KMS_SOCKET_PATH=/run/shieldme-relay-kms/kms.sock
Environment=RELAY_KMS_KEY_DIR=/var/lib/shieldme-relay-kms
EnvironmentFile=-/etc/shieldme/relay-kms.env
ExecStart=/usr/bin/node /usr/local/libexec/shieldme-relay-kms.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/shieldme-relay-kms /var/lib/shieldme-relay-kms
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
