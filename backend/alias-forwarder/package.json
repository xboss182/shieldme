{
  "name": "alias-forwarder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run audit && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:reserved-postgres": "RUN_POSTGRES_REGRESSION=1 vitest run src/modules/aliases/aliases.postgres.test.ts",
    "reserved:generate": "tsx src/scripts/generate-reserved-local-parts.ts",
    "reserved:check": "tsx src/scripts/generate-reserved-local-parts.ts --check",
    "reserved:apply": "tsx src/scripts/apply-reserved-local-parts.ts",
    "reserved:collisions": "tsx src/scripts/report-reserved-local-part-collisions.ts",
    "relay:kek:rotate": "tsx src/scripts/rotate-relay-kek.ts",
    "relay:restore:verify": "tsx src/scripts/verify-relay-restore.ts",
    "verify:backfill": "tsx src/scripts/backfill-transparency.ts",
    "relay:egress:verify": "./scripts/verify-relay-egress.sh",
    "security:audit": "npm audit --audit-level=high",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "bullmq": "5.79.3",
    "dotenv": "16.4.5",
    "drizzle-orm": "0.45.2",
    "express": "4.22.2",
    "express-prom-bundle": "8.0.0",
    "express-rate-limit": "8.5.2",
    "helmet": "8.1.0",
    "ioredis": "5.4.1",
    "jsonwebtoken": "9.0.2",
    "mailparser": "3.9.14",
    "nodemailer": "9.0.3",
    "openpgp": "5.11.3",
    "pg": "8.13.1",
    "pino": "9.5.0",
    "pino-http": "10.4.0",
    "prom-client": "15.1.3",
    "resend": "6.17.1",
    "smtp-server": "3.19.2",
    "spamscanner": "^6.1.5",
    "svix": "1.96.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/mailparser": "3.4.6",
    "@types/node": "22.10.1",
    "@types/pg": "8.20.0",
    "@types/smtp-server": "3.5.13",
    "@types/supertest": "7.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.4",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "5.7.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "node-fetch": "2.7.0",
    "nodemailer": "9.0.3",
    "sharp": "0.35.0",
    "tar": "7.5.19",
    "undici": "8.7.0"
  }
}
